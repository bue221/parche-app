# Copy to .env for local Compose. Do not put real production secrets here.

DATABASE_URL=postgres://parche:parche@postgres:5432/parche?sslmode=disable
REDIS_URL=redis://redis:6379/0
BROKER_URL=nats://broker:4222
HTTP_ADDR=:8080

JWT_ACCESS_SECRET=parche-dev-jwt-access-secret-32b
JWT_REFRESH_SECRET=parche-dev-jwt-refresh-secret-32
TICKET_SIGNING_KEY=change-me-ticket-dev-only-32chars!
# Optional rotation ring (JSON). First object is the active kid; extra kids stay valid for verify grace.
TICKET_SIGNING_KEYS=

OBJECT_STORE_DRIVER=minio
OBJECT_STORE_ENDPOINT=minio:9000
OBJECT_STORE_BUCKET=parche
OBJECT_STORE_ACCESS_KEY=parcheminio
OBJECT_STORE_SECRET_KEY=parcheminio
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_USE_SSL=false
OBJECT_STORE_PATH=./data/media
# Optional CDN prefix for GetPublicURL (CloudFront). Leave empty in local MinIO.
OBJECT_STORE_PUBLIC_BASE_URL=http://localhost:9000/parche

PAYMENT_WEBHOOK_SECRET=change-me-webhook-dev-only

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=parche@localhost
# log (default), mailhog (local catcher), smtp (prod). Do not put real SMTP passwords in git.
EMAIL_DRIVER=log

# Grants platform_admin to this existing user on API start (F27). Demo seed also uses admin@parche.test.
BOOTSTRAP_ADMIN_EMAIL=admin@parche.test

CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:8081
APP_ORIGIN=http://localhost:8081
APP_ENV=dev
PAYMENT_PROVIDER=fake
PAYMENT_CHECKOUT_BASE_URL=

# Public API origin used to derive Mercado Pago webhook and OAuth URLs.
# Local: http://localhost:8080
# Prod: https://api-parche.bue221.xyz
# API_PUBLIC_URL=http://localhost:8080

# Mercado Pago Checkout Pro (Colombia, COP). Copy only what the credentials card shows:
# Access Token, Public Key, Application number. Test user / password / verification code
# are for logging into checkout, not for this file. Then set PAYMENT_PROVIDER=mercadopago.
# price_cents in Parche are already COP pesos — do not divide by 100.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_CLIENT_ID=
MP_APPLICATION_ID=
# Required to let organizers connect their own Mercado Pago (OAuth of Mercado Pago, not Auth0).
# Tus integraciones → app → Editar datos. Redirect URI:
# https://api-parche.bue221.xyz/v1/payments/mercadopago/oauth/callback
MP_CLIENT_SECRET=
# Optional. Appears after you save a webhook in the dashboard. APP_ENV=dev can skip it.
# Prod webhook: https://api-parche.bue221.xyz/v1/payments/webhook
MP_WEBHOOK_SECRET=
MP_OAUTH_REDIRECT_URL=
MP_NOTIFICATION_URL=
MP_BACK_URL_BASE=
MP_TOKEN_KEY=
# Ignored. Comisión 10% + IVA 19% sobre esa comisión se calcula sola.
MP_MARKETPLACE_FEE=0
LOG_LEVEL=info
