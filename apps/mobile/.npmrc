# Expo + React Native: flatten node_modules like npm.
# Isolated installs are supported from SDK 54+, but hoisted remains the
# create-expo-app default and avoids Metro resolution surprises.
node-linker=hoisted

# Fail when engines.node / engines.pnpm in package.json are not met.
engine-strict=true

# Run this project's preinstall/postinstall scripts (needed by only-allow).
enable-pre-post-scripts=true

# pnpm 10+ can self-switch to the version in package.json#packageManager.
manage-package-manager-versions=true
package-manager-strict=true
