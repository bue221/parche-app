# Canonical URL of this marketing site (sitemap, OG, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://parche.app

# Public events API (server-only). Used for ISR event pages and sitemap.
API_URL=http://localhost:8080

# Hosts allowed in next/image for flyers (comma-separated host[:port]).
MEDIA_HOSTS=localhost:9000

# Expo web build of app-frontend (local: pnpm web → http://localhost:8081).
NEXT_PUBLIC_APP_WEB_URL=http://localhost:8081

# Native store listings. Leave empty until the apps are published;
# CTAs only render when these are set.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Public contact email (legal pages, footer copy).
NEXT_PUBLIC_CONTACT_EMAIL=hola@parche.app
