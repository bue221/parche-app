# Auth/registry only. Linker, engines, and scripts: pnpm-workspace.yaml
# (pnpm 12+ does not read node-linker from this file).

engine-strict=true

# Run this project's preinstall/postinstall scripts (needed by only-allow).
enable-pre-post-scripts=true

# pnpm 10+ can self-switch to the version in package.json#packageManager.
manage-package-manager-versions=true
package-manager-strict=true
